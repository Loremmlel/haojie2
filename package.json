{
  "name": "haojie2",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*/*.test.ts",
    "test:game": "tsx --test tests/ai/*.test.ts tests/core/*.test.ts tests/economics/*.test.ts tests/kernel/*.test.ts tests/session/*.test.ts tests/shrine/*.test.ts tests/ultimate/*.test.ts",
    "test:training-ui": "tsx --test tests/training/*.test.ts",
    "test:browser": "node tests/browser/game.mjs",
    "format": "prettier --config config/prettier.json --ignore-path config/prettierignore --write .",
    "format:check": "prettier --config config/prettier.json --ignore-path config/prettierignore --check .",
    "deploy": "node scripts/pages.mjs",
    "deploy:check": "node scripts/pages.mjs --check",
    "test:pages": "node tests/browser/pages.mjs",
    "test:browser:ai": "node tests/browser/ai.mjs",
    "play:cli": "tsx scripts/ai/play.ts",
    "native:rules:check": "tsx scripts/native/engine/rules-package.ts --check",
    "native:validate": "tsx scripts/native/engine/validation/run.ts",
    "native:build": "cargo build --locked --release --manifest-path native/engine/Cargo.toml --target-dir artifacts/native-target",
    "training:validate": "tsx scripts/native/learning/validate.ts",
    "training:web:build": "node scripts/training/build-web.mjs",
    "training:web:check": "node scripts/training/build-web.mjs --check",
    "training:web:test": "node tests/browser/console/training.mjs",
    "training:web:views": "node tests/browser/console/views.mjs",
    "native:check": "cargo clippy --locked --all-targets --manifest-path native/engine/Cargo.toml --target-dir artifacts/native-target -- -D warnings",
    "native:test": "cargo test --locked --manifest-path native/engine/Cargo.toml --target-dir artifacts/native-target",
    "preview:vfx": "node scripts/vfx/build-preview.mjs",
    "test:browser:vfx": "node tests/browser/vfx.mjs",
    "test:browser:shrine": "node tests/browser/shrine.mjs",
    "test:browser:feedback3": "node tests/browser/feedback3.mjs",
    "test:browser:feedback4": "node tests/browser/feedback4.mjs",
    "test:browser:online": "node tests/browser/online.mjs",
    "test:browser:library": "node tests/browser/library/references.mjs",
    "check:structure": "node scripts/check-structure.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.10",
    "playwright": "1.55.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
